# PostgreSQL connection string (Render/Supabase/Neon etc.)
DATABASE_URL="postgresql://user:password@host:5432/leadcrm"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"

# WhatsApp Cloud API (from Meta Business / developers.facebook.com)
WHATSAPP_TOKEN="your-permanent-or-temp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_VERIFY_TOKEN="pick-any-random-string-you-set-in-meta-webhook-config"

# Web Push (VAPID keys) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-public-key"
VAPID_PRIVATE_KEY="your-private-key"
VAPID_SUBJECT="mailto:you@yourdomain.com"

# CORS - your frontend URL
FRONTEND_URL="http://localhost:5173"

PORT=4000
