generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum LeadStatus {
  NEW
  CONTACTED
  WAITING
  SALE
  FAILED
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(STAFF)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())

  assignedLeads Lead[]      @relation("AssignedStaff")
  notes         Note[]
  followUps     FollowUp[]
  pushSubs      PushSubscription[]
  deviceTokens  DeviceToken[]
}

model Lead {
  id                 String     @id @default(uuid())
  phoneNumber        String     @unique
  name               String?
  whatsappProfileName String?
  status             LeadStatus @default(NEW)
  assignedStaffId    String?
  assignedStaff      User?      @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  source             String?
  metaLeadId         String?
  metaFormId         String?
  metaAdId           String?
  aiScore            Int?
  aiGrade            String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deleted            Boolean    @default(false)

  notes          Note[]
  followUps      FollowUp[]
  messages       Message[]
  whatsappLogs   WhatsAppLog[]
  conversations  Conversation[]
}

model Note {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  staffId   String
  staff     User     @relation(fields: [staffId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model FollowUp {
  id                 String    @id @default(uuid())
  leadId             String
  lead               Lead      @relation(fields: [leadId], references: [id])
  staffId            String
  staff              User      @relation(fields: [staffId], references: [id])
  scheduledAt        DateTime
  remindBeforeMinutes Int      @default(10)
  notified           Boolean   @default(false)
  completed          Boolean   @default(false)
  createdAt          DateTime  @default(now())
}

model Message {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  direction String   // "in" or "out"
  content   String
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model WhatsAppLog {
  id             String   @id @default(uuid())
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id])
  phoneNumber    String
  contactName    String?
  messagePreview String?
  capturedAt     DateTime @default(now())
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())

  @@unique([userId, token])
}

model MetaIntegration {
  id              String   @id @default(uuid())
  userId          String
  pageId          String   @unique
  pageName        String?
  accessToken     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  conversions MetaConversionConfig[]
}

model MetaConversionConfig {
  id              String   @id @default(uuid())
  integrationId   String
  integration     MetaIntegration @relation(fields: [integrationId], references: [id])
  pixelId         String
  accessToken     String
  partnerAgent    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Conversation {
  id                      String   @id @default(uuid())
  leadId                  String
  lead                    Lead     @relation(fields: [leadId], references: [id])
  platform                String
  platformConversationId  String?
  lastMessageAt           DateTime
  unreadCount             Int      @default(0)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())

  messages InboxMessage[]
}

model InboxMessage {
  id                String   @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  direction         String
  content           String
  platformMessageId String?
  createdAt         DateTime @default(now())
}

model FieldMapping {
  id              String   @id @default(uuid())
  metaFieldName   String
  crmFieldName    String
  isRequired      Boolean  @default(false)
  defaultValue    String?
  createdAt       DateTime @default(now())
}
